# ==============================================================================
# BASE DE DONNÉES POSTGRESQL
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/senwisetool_db

# ==============================================================================
# PARAMÈTRES GÉNÉRAUX DE L'APPLICATION
# ==============================================================================
PROJECT_NAME="SenWiseTool Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
FRONTEND_URL="http://localhost:3000"

# ==============================================================================
# SÉCURITÉ & JETONS JWT
# ==============================================================================
SECRET_KEY="senwisetool-super-secure-production-ready-jwt-secret-key-32charsmin!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30
MFA_TOKEN_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ==============================================================================
# POLITIQUES DE PROTECTION CONTRE LES ATTAQUES BRUTE-FORCE
# ==============================================================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ==============================================================================
# COOKIES HTTPONLY
# ==============================================================================
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# ==============================================================================
# CONFIGURATION EMAIL / SMTP (Service d'envoi d'e-mails professionnel)
# ==============================================================================
# Activer l'envoi réel par SMTP (true) ou simuler avec affichage terminal (false)
SMTP_ENABLED=true

# Hôte SMTP (exemples courants) :
# - Gmail : smtp.gmail.com (port 587 avec STARTTLS)
# - SendGrid : smtp.sendgrid.net (port 587)
# - Brevo (Sendinblue) : smtp-relay.brevo.com (port 587)
# - Mailgun : smtp.mailgun.org (port 587)
# - Infomaniak / OVH : mail.infomaniak.com / ssl0.ovh.net (port 587 ou 465)
# - Local test (Mailpit / MailHog) : localhost (port 1025)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Identifiants d'authentification SMTP
# Pour Gmail : utilisez une "Adresse e-mail" et un "Mot de passe d'application" (16 caractères)
# généré sur https://myaccount.google.com/apppasswords
SMTP_USER=jlove.livestyle@gmail.com
SMTP_PASSWORD="xjgq tafo ggye tcvn"

# Paramètres de sécurité réseau
# STARTTLS (recommandé pour port 587) : true
# SSL direct (pour port 465) : false
SMTP_TLS=true
SMTP_SSL=false

# Identité de l'expéditeur officiel
EMAILS_FROM_EMAIL=noreply@senwisetool.com
EMAILS_FROM_NAME="SenWiseTool Platform"